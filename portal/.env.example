# ── CONFIGURATION TEMPLATE ────────────────────────────────────────────────────────────────────
#
# Copy to `.env` and fill in. ⚠ NO POPULATED `.env` IS COMMITTED TO THIS REPO: it holds
# live values (NEXTAUTH_SECRET, COGNITO_CLIENT_SECRET, DESKTOP_ACCESS_KEY_SECRET, GITHUB_TOKEN) and
# those must not go into git history. `.gitignore` keeps `.env` out.
#
# ⚠ THIS LIST IS WHAT THE CODE READS, not what the old file contained. Every name below appears in `src/`
# (or is read by next-auth itself); four that sat in the old `.env` are deliberately absent because nothing
# in this app reads them any more — DESKTOP_ACCESS_KEY_SECRET and COGNITO_REDIRECT_URI (the access key is
# minted elsewhere and the redirect is derived), NEXT_PUBLIC_PLATFORM_NAME, and GITHUB_TOKEN. Carrying them
# forward would be four variables an operator sets and then wonders why nothing changes.
#
# ⚠ SECRET HANDLING — NEXTAUTH_SECRET and COGNITO_CLIENT_SECRET are the two long-lived secrets
# this application depends on. See "Secret management" in README.md for the rotation policy
# (90-day cycle) and the revocation procedure.

# ── BACKEND ───────────────────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# The origin the DESKTOP app should call for /v1/*. Falls back to NEXT_PUBLIC_BACKEND_URL then BACKEND_URL,
# so it can stay empty in local dev where all three are the same gateway. It exists separately because in a
# deployment they diverge: the portal may reach a private backend while the desktop needs the public URL.
# The config route serves 503 rather than a partial answer if a required value is missing.
DESKTOP_API_BASE_URL=

# ── APP + SESSION ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
# Signs and encrypts the session JWE cookie. Generate with: openssl rand -base64 32
# ⚠ Rotate every 90 days. See "Secret management" in README.md.
NEXTAUTH_SECRET=
# The OUTGOING key, set only for the duration of a rotation.
#
# ⚠ THIS IS WHAT MAKES A ROTATION SOMETHING OTHER THAN A FORCED SIGN-OUT FOR EVERYONE. Auth.js tries
# each key on decode and issues with the first, so during the overlap existing session cookies keep
# working while new ones use the new key. Sequence: copy the current value here, set NEXTAUTH_SECRET
# to the new one, deploy, then REMOVE this variable once the longest session could have expired (24h).
#
# ⚠ LEAVE IT UNSET UNLESS YOU ARE MID-ROTATION. While set, the old key still mints valid sessions —
# which is the point during a planned rotation and exactly wrong during an emergency revocation.
NEXTAUTH_SECRET_PREVIOUS=

# ── COGNITO (native auth) ─────────────────────────────────────────────────────────────────────
# Mirror the deployed stack's AdminEnvBlock output. CLIENT_SECRET is empty for a public app client.
# ⚠ Rotate COGNITO_CLIENT_SECRET every 90 days when set. See "Secret management" in README.md.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_HOSTED_UI_DOMAIN=

# The same pool and app client, exposed to the BROWSER for the Amplify Auth SDK behind the custom auth
# screens. NEXT_PUBLIC_ bakes these into the client bundle — which is fine and unavoidable: both already
# travel in every Hosted UI URL and in the public GET /v1/auth/config, and this app client has no secret.
# Neither is a credential; the pool's own policies are the control.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────────────────────
# How long an invite link stays valid. Defaults in code; set to override.
INVITE_TTL_HOURS=
# Minimum gap between invite emails, to stay under the SES send rate. Defaults in code.
SES_SEND_GAP_MS=
