# ⚠ PINS THE PUBLIC REGISTRY, AND THIS FILE IS NOT OPTIONAL.
#
# Without it, pnpm falls back to whatever registry the machine's global ~/.npmrc names — if that is a
# private mirror, `pnpm install` fails with ERR_PNPM_FETCH_401 on the first public package. The failure
# looks like a broken repo and is not one.
registry=https://registry.npmjs.org/

# pnpm's default "isolated" linker fills node_modules with symlinks into the store, Amplify Hosting's
# artifact packaging does not follow symlinks, and the deployed bundle arrives without its dependencies —
#
#   The 'node_modules' folder is missing the 'next' dependency.
#
# "hoisted" installs a flat, npm-style node_modules of real directories, which packages correctly.
node-linker=hoisted

# ── ⚠ A QUARANTINE WINDOW ON EVERY DEPENDENCY ────────────────────────────────────────────────
#
# 24 hours. Without it a fresh resolution can install a version published minutes earlier, which is
# the vector the 2025-26 npm account-takeover worms used: publish a malicious patch, wait for the
# next CI install. The blast radius here is a build that handles NEXTAUTH_SECRET and
# COGNITO_CLIENT_SECRET.
#
# ⚠ IT DOES NOT AFFECT `--frozen-lockfile` INSTALLS, which resolve nothing — so CI is unchanged and
# this only bites when somebody deliberately updates a dependency. If an urgent security patch needs
# to land inside the window, `--config.minimum-release-age=0` is the documented override, and using
# it should be a considered decision rather than a default.
minimum-release-age=1440
