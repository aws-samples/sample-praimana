{
  "name": "@praimana/desktop-service",
  "version": "1.0.0",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "esbuild src/handler.ts --bundle --minify --platform=node --target=node22 --outdir=dist --format=esm --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --external:@aws-sdk/*",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@praimana/service-shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1096.0",
    "@aws-sdk/s3-request-presigner": "3.1096.0",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.11"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
