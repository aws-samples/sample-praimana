{
  "name": "@praimana/identity-service",
  "version": "1.0.0",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "esbuild src/handler.ts --bundle --minify --platform=node --target=node22 --outdir=dist --format=esm --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --external:@aws-sdk/*",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@praimana/service-shared": "workspace:*",
    "@praimana/shared": "workspace:*",
    "@aws-sdk/client-cloudwatch": "3.1113.0",
    "@aws-sdk/client-cost-explorer": "3.1113.0",
    "@aws-sdk/lib-dynamodb": "3.1113.0",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.11",
    "ulid": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
