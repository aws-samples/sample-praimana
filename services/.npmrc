# ⚠ WITHOUT THIS FILE `pnpm install` FAILS ON A CLEAN CLONE, AND THE ERROR NAMES THE WRONG CAUSE.
#
# Without it pnpm falls back to the machine's global registry — if that is a private mirror, the
# install dies on the first PUBLIC package it asks for:
#
#   ERR_PNPM_FETCH_401  GET <private-mirror>/npm/.../typescript: Unauthorized
#
# It reads as an auth problem with this repo. It is not: it is the wrong registry being asked for a
# package it does not carry. Pinning the public registry here is what keeps a clean clone installable.
registry=https://registry.npmjs.org/

# Some tooling here resolves through real paths rather than pnpm's symlinked store; hoisting keeps
# that working.
node-linker=hoisted

# ── ⚠ SUPPLY-CHAIN COOLDOWN ───────────────────────────────────────────────────────────────────
#
# These workspace packages share one lockfile and ship the Lambda bundles, so a compromised
# dependency reaches the platform through any one of them. A release-age cooldown on every repo is
# the point: a cooldown on some but not all is a cooldown on none.
#
# WHAT IT DEFENDS AGAINST, AND WHY SCA DOES NOT COVER IT. The dependency-vulnerability gate
# (`pnpm audit --audit-level=high`, in buildspec-publish.yml) can only match against ADVISORIES —
# which exist only after someone has discovered and reported the problem. The realistic npm
# supply-chain attack is a legitimate package whose publish token was stolen, and there is no
# advisory for the hours or days before that is noticed. A release-age cooldown is the control for
# that window. The two are complements, not alternatives: audit catches what is known, the cooldown
# buys the time in which things become known.
#
# ⚠ THE UNIT IS MINUTES. 10080 = 7 days. A deployment cadence that needs a shorter floor can lower
# this; keep the repos that share a lockfile consistent.
#
# An urgent security release can still be taken deliberately with
# `--config.minimum-release-age=0`, or by pinning the exact version — fast when a human decides,
# slow by default.
minimum-release-age=10080
