{
  "name": "@praimana/desktop",
  "productName": "Praimana",
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "license": "MIT-0",
  "main": "dist/main/index.js",
  "description": "Praimana \u2014 workshop client with an in-app AI coding assistant, team chat, board and phases.",
  "author": "Praimana",
  "scripts": {
    "dev": "bash scripts/patch-electron-name.sh && vite",
    "rebuild-native": "bash scripts/rebuild-native.sh",
    "build": "vite build && tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder",
    "type-check": "tsc --noEmit && tsc -p tsconfig.main.json",
    "lint": "eslint src/ shared/",
    "test": "LC_ALL=en_GB.UTF-8 LANG=en_GB.UTF-8 vitest run",
    "test:watch": "LC_ALL=en_GB.UTF-8 LANG=en_GB.UTF-8 vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.233",
    "aws-amplify": "6.20.0",
    "better-sqlite3": "13.0.3",
    "remark-gfm": "4.0.1",
    "simple-git": "4.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/better-sqlite3": "7.6.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "electron": "43.7.6",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "9.1.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.4",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "0.14.7",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.amazon.praimana.desktop",
    "productName": "Praimana",
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Praimana Access Key",
        "schemes": [
          "praimana"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "icon": "build/icon.png",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "files": [
        "!node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-linux-*/**",
        "!node_modules/better-sqlite3/prebuilds/win32-*",
        "!node_modules/better-sqlite3/prebuilds/linux-*",
        "!node_modules/better-sqlite3/prebuilds/linuxmusl-*"
      ],
      "x64ArchFiles": "**/better-sqlite3/prebuilds/darwin-*.node"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "files": [
        "!node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**",
        "!node_modules/@anthropic-ai/claude-agent-sdk-linux-*/**",
        "!node_modules/better-sqlite3/prebuilds/darwin-*",
        "!node_modules/better-sqlite3/prebuilds/linux-*",
        "!node_modules/better-sqlite3/prebuilds/linuxmusl-*"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "artifactName": "Praimana-${version}-${arch}.${ext}"
  }
}
