# ⚠ PINS THE PUBLIC REGISTRY, AND THIS FILE IS NOT OPTIONAL.
#
# Without it, pnpm falls back to whatever registry the machine's global ~/.npmrc names — if that is a
# private mirror, `pnpm install` fails with ERR_PNPM_FETCH_401 on the first public package. The failure
# looks like a broken repo and is not one.
registry=https://registry.npmjs.org/

# pnpm's default "isolated" linker builds node_modules from symlinks into the store; electron-builder
# and Amplify's packaging both need real directories.
node-linker=hoisted

# ── ⚠ SUPPLY-CHAIN COOLDOWN ───────────────────────────────────────────────────────────────────
#
# This repo resolves 811 dependencies and carries caret ranges on `electron-builder` and
# `better-sqlite3`, so `pnpm update` can pull a version published minutes ago. The realistic
# supply-chain threat is not a long-standing malicious package — it is a legitimate one whose publish
# token was stolen — and those are typically caught and unpublished within days.
#
# 7 days trades "newest possible" for "someone else has run it first". A genuinely urgent security
# release can still be taken deliberately with `--config.minimum-release-age=0` or an exact pin,
# which is the right shape: fast when a human decides, slow by default.
#
# ⚠ THE UNIT IS MINUTES, NOT DAYS. The key is `minimum-release-age`, and pnpm silently ignores a
# misspelled custom key (for example `min-release-age`), which reads as present in review but protects
# nothing. 7 days = 10080 minutes. Verify a control does something before trusting the comment above it.
minimum-release-age=10080
